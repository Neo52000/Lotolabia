# LotoLab IA — API. Copier vers .env et renseigner les valeurs.
# AUCUN de ces secrets ne doit être commité.

# --- Application ---
ENVIRONMENT=development            # development | staging | production
DEBUG=false
LOG_LEVEL=INFO

# --- Supabase (obligatoire en production) ---
SUPABASE_URL=                      # https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=         # clé service role (Dashboard > Settings > API) — SERVEUR UNIQUEMENT
SUPABASE_JWT_SECRET=               # secret JWT legacy (HS256) si utilisé
SUPABASE_JWKS_URL=                 # https://<ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- Sécurité HTTP ---
CORS_ORIGINS=http://localhost:3000 # origines autorisées, séparées par des virgules
RATE_LIMIT_DEFAULT=120/minute

# --- Collecteur de tirages ---
# URLs directes des fichiers historiques officiels (CSV ou ZIP), séparées par des virgules.
# Page de référence (portail, PAS un lien de fichier direct) :
#   https://www.fdj.fr/jeux-de-tirage/loto/historique
# Cette page n'a pas pu être explorée depuis l'environnement de développement
# (domaine fdj.fr bloqué par le proxy réseau). Récupérer le(s) lien(s) de
# téléchargement CSV/ZIP réel(s) depuis un navigateur (bouton de téléchargement,
# ou onglet Réseau des outils développeur) et les renseigner ci-dessous.
# Voir docs/IMPORT_AUTOMATIQUE.md.
COLLECTOR_HISTORY_URLS=
SCHEDULER_ENABLED=false            # true sur UNE seule instance de production
SCHEDULER_TIMEZONE=Europe/Paris
COLLECTOR_MAX_RETRIES=5
COLLECTOR_RETRY_BACKOFF_SECONDS=60

# --- Cache ---
CACHE_TTL_SECONDS=300

# --- Limites offre gratuite ---
FREE_SAVED_GRIDS_LIMIT=5
FREE_HISTORY_LIMIT=100

# --- Achats intégrés (désactivés par défaut) ---
STORE_VALIDATION_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=          # ex. fr.lotolab.ia (à créer dans la Play Console)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=  # chemin du JSON de compte de service (serveur uniquement)
APP_STORE_SHARED_SECRET=           # secret partagé App Store Connect
