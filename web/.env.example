# LotoLab IA — site web. Copier vers .env.local.
# URL publique de l'API FastAPI (côté serveur ET client)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# URL canonique du site (SEO) — domaine à définir
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase (auth du back-office) — clé « anon » publique uniquement
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Paiement Premium (Stripe) — variables SERVEUR uniquement, jamais NEXT_PUBLIC_ ---
# Voir docs/MONETISATION.md. Vides = paiement désactivé (les routes répondent 501).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Clé service role Supabase : seule autorisée à écrire les droits Premium.
SUPABASE_SERVICE_ROLE_KEY=
# URL publique du site (redirections Stripe) ; à défaut, NEXT_PUBLIC_SITE_URL.
SITE_URL=
