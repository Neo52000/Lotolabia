# LotoLab IA — site web. Copier vers .env.local.
# URL publique de l'API FastAPI (côté serveur ET client)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# URL canonique du site (SEO) — domaine à définir
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase (auth du back-office) — clé « anon » publique uniquement
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
